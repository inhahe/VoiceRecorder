<?xml version="1.0" encoding="utf-8"?>
<!-- Custom title for the "input not connected" prompt. AlertDialog can't show a message and a
     list at once, and the list only makes sense with the explanation above it. The padding
     mirrors AppCompat's own title template. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingTop="18dp"
    android:paddingEnd="?attr/dialogPreferredPadding">

    <TextView
        android:id="@+id/input_prompt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/input_prompt_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
